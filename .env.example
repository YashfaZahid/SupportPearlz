# --- LLM ---
# Provider: openai | groq | ollama (openai-compatible base URL optional)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# Required when LLM_PROVIDER=openai (or when using OpenAI embeddings)
OPENAI_API_KEY=sk-your-key-here
# Optional OpenAI-compatible endpoint (Groq/Ollama/Azure-style gateways)
# OPENAI_API_BASE=https://api.openai.com/v1

# --- Embeddings (must match index; rebuild after change) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Vector store ---
VECTOR_STORE_PATH=data/vector_store
COLLECTION_NAME=pearlz_kb

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
RETRIEVAL_K=4
RETRIEVAL_STRATEGY=mmr
# Max Chroma cosine distance accepted by the relevance gate (lower distance = better match)
SCORE_THRESHOLD=0.75
# mmr only
MMR_FETCH_K=12
MMR_LAMBDA=0.5

# --- Context & history ---
HISTORY_MAX_TURNS=6
CONTEXT_MAX_CHARS=12000
CONTEXT_MAX_CHUNKS=6

# --- Caching (strategy 1: LangChain in-memory/sqlite cache) ---
# strategy 2 is Streamlit @st.cache_resource in the UI layer (always on when UI runs)
ENABLE_LANGCHAIN_CACHE=true
LANGCHAIN_CACHE_PATH=data/cache/langchain.db

# --- Streaming (Streamlit UI) ---
ENABLE_STREAMING=true

# --- Support / safety ---
SUPPORT_ESCALATION_EMAIL=support@pearlzhome.example
# Shown prominently in CLI banner and Streamlit header
MEDICAL_SAFETY_DISCLAIMER=SupportPearlz answers from Pearlz product documentation only. It is not a medical device advisor and must not be used for clinical decisions. Never invent health claims, certifications, or treatment advice. If water quality or health concerns persist, contact a qualified professional and Pearlz support.

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/supportpearlz.log
